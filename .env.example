# Hi-Protein configuration. Copy to .env and edit; .env is gitignored.
# Every variable has a working default, so an empty .env is a valid .env.

# --- Backend -----------------------------------------------------------------

# Force every external client (IGN RPG, ADEME Agribalyse) to serve from the local
# disk cache and never touch the network. Set this to 1 before a live demo on
# untrusted conference wifi: with the cache in data/cache/ the app is fully
# functional offline, and /health reports offline_mode: true.
HIPROTEIN_OFFLINE=0

# Monte Carlo trajectory count when a request does not specify one.
# 2000 is the default; requests may override within 200..20000.
HIPROTEIN_N_SIM=2000

# Timeout in seconds for any outbound call to an open-data API.
HIPROTEIN_HTTP_TIMEOUT=6.0

# Comma-separated CORS origins. Only needed when the frontend is served from a
# DIFFERENT origin than the API — which is exactly the case on Vercel, where the
# browser loads the bundle from your-app.vercel.app and calls the API elsewhere.
# When one process serves both (make serve), the origin matches and this is unused.
HIPROTEIN_CORS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Serve the app under a path prefix instead of the domain root. Only set this
# when a reverse proxy forwards the prefix intact rather than stripping it.
# HIPROTEIN_ROOT_PATH=/app

# --- Frontend (build time, read by Vite) -------------------------------------

# Absolute base URL of the API, including the /api/v1 suffix. Leave unset when
# the API and the bundle are served by one process: the frontend then resolves
# the API relative to the page it was loaded from, which also survives being
# mounted under a proxy prefix.
#
# Set it when they are split across origins, e.g. a Vercel frontend:
# VITE_API_BASE=https://hi-protein-api.example.com/api/v1

# Dev-server proxy target for `npm run dev`. Defaults to http://127.0.0.1:8099.
# VITE_API_TARGET=http://127.0.0.1:8099

# Extra hostnames Vite's dev/preview server should accept, comma-separated, or
# `true` to disable the DNS-rebinding host check entirely. The usual tunnel
# providers are already allowed; see frontend/vite.config.js.
# VITE_ALLOWED_HOSTS=.example.com

# Hostname for the hot-reload websocket when the dev server is behind an HTTPS
# proxy. Unset for plain local use.
# VITE_HMR_HOST=my-workspace.example.com
