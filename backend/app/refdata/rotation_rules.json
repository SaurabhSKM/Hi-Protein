{
  "_meta": {
    "description": "Deterministic agronomic rule matrix. Return intervals are minimum years between two host crops of the same soil-borne disease group, not merely the same species - this is the correction that matters agronomically, because Aphanomyces euteiches carries over between pea, lentil and vetch.",
    "source": "Terres Inovia technical guidance on crop return intervals and soil-borne disease management (Cap Proteines / Cap Proteines+ references).",
    "disclaimer": "Rules are a screening aid. A soil Aphanomyces test (test en pot / indice de risque) remains the only reliable way to clear a plot for pea."
  },
  "disease_groups": {
    "aphanomyces": {
      "pathogen": "Aphanomyces euteiches",
      "label_fr": "Pourriture racinaire du pois",
      "host_crops": [
        "field_pea",
        "winter_pea",
        "green_lentil",
        "alfalfa",
        "other_legume"
      ],
      "min_return_interval_years": 6,
      "severity": "high",
      "note": "No effective chemical control. Inoculum persists over a decade. Interval applies across ALL host species, so lentil after pea is as risky as pea after pea.",
      "partial_hosts": [
        "fava_bean"
      ],
      "partial_host_interval_years": 3
    },
    "fava": {
      "pathogen": "Didymella fabae / Botrytis fabae",
      "label_fr": "Anthracnose et botrytis de la feverole",
      "host_crops": [
        "fava_bean"
      ],
      "min_return_interval_years": 4,
      "severity": "medium"
    },
    "ascochyta": {
      "pathogen": "Ascochyta rabiei",
      "label_fr": "Anthracnose du pois chiche",
      "host_crops": [
        "chickpea"
      ],
      "min_return_interval_years": 5,
      "severity": "high"
    },
    "sclerotinia": {
      "pathogen": "Sclerotinia sclerotiorum",
      "label_fr": "Sclerotiniose",
      "host_crops": [
        "soybean",
        "rapeseed",
        "sunflower"
      ],
      "min_return_interval_years": 4,
      "severity": "medium",
      "note": "Shared with rapeseed and sunflower, so soy after rapeseed carries real risk."
    }
  },
