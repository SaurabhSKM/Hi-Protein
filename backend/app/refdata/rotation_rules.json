  "sowing_windows": {
    "field_pea": {
      "start": "02-20",
      "end": "03-25",
      "note_fr": "Semer tot des que le sol est portant; un semis tardif expose la floraison au stress thermique de juin."
    },
    "winter_pea": {
      "start": "10-25",
      "end": "11-20",
      "note_fr": "Semis d'automne; exige un sol sain, non hydromorphe."
    },
    "fava_bean": {
      "start": "02-15",
      "end": "03-20",
      "note_fr": "Feverole de printemps. Variantes d'hiver semees fin octobre a mi-novembre."
    },
    "green_lentil": {
      "start": "03-01",
      "end": "03-25",
      "note_fr": "Semis peu profond (2-3 cm) sur sol bien ressuye; eviter les sols hydromorphes."
    },
    "chickpea": {
      "start": "02-25",
      "end": "03-30",
      "note_fr": "Exige un sol filtrant et rechauffe; tres sensible a l'exces d'eau en levee."
    },
    "soybean": {
      "start": "04-20",
      "end": "05-20",
      "note_fr": "Semis apres rechauffement du sol (>12 C); irrigation souvent necessaire en annee seche."
